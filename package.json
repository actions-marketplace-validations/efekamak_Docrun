{
  "name": "docrun",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Execute a declared package quickstart contract in a fresh temporary workspace and turn failures into evidence-backed maintainer reports.",
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "agent-sdk validate --dir .",
    "catalog:validate": "node --import tsx scripts/validate-catalog.ts",
    "catalog:run": "node --import tsx scripts/run-catalog.ts",
    "status:aggregate": "node --import tsx scripts/aggregate-status.ts",
    "site:build": "node --import tsx scripts/build-status-site.ts",
    "action:build": "ncc build action/index.ts -o dist-action --minify --license licenses.txt",
    "action:verify": "node --check dist-action/index.js && node --import tsx scripts/verify-action-bundle.ts",
    "dev": "agent-sdk dev"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@grok/agent-sdk": "0.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vercel/ncc": "0.45.0",
    "typescript": "6.0.3"
  }
}
