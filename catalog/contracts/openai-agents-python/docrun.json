{
  "schemaVersion": 1,
  "name": "openai-agents-python",
  "files": {
    "example.py": "from agents import Agent, Runner\n\nagent = Agent(name=\"DocrunAssistant\", instructions=\"You are a helpful assistant.\")\nassert agent.name == \"DocrunAssistant\"\nassert hasattr(Runner, \"run\")\nprint(\"openai-agents-python-ready\")\n"
  },
  "steps": [
    {
      "id": "install",
      "command": "pip",
      "args": ["install", "--no-input", "openai-agents"],
      "timeoutMs": 240000,
      "expect": {
        "exitCode": 0
      }
    },
    {
      "id": "resolved-version",
      "command": "pip",
      "args": ["list", "--format=json"],
      "timeoutMs": 30000,
      "expect": {
        "exitCode": 0
      }
    },
    {
      "id": "verify-agent",
      "command": "python",
      "args": ["example.py"],
      "timeoutMs": 30000,
      "expect": {
        "exitCode": 0,
        "stdoutIncludes": ["openai-agents-python-ready"]
      }
    }
  ]
}
