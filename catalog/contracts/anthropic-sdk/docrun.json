{
  "schemaVersion": 1,
  "name": "anthropic-sdk",
  "files": {
    "package.json": "{\n  \"name\": \"anthropic-sdk-consumer\",\n  \"private\": true,\n  \"type\": \"module\"\n}\n",
    "example.mjs": "import Anthropic from \"@anthropic-ai/sdk\";\n\nconst client = new Anthropic({ apiKey: \"placeholder-local-check\" });\nif (typeof client.messages?.create !== \"function\") {\n  throw new Error(\"Expected client.messages.create to be a function\");\n}\nconsole.log(\"anthropic-sdk-ready\");\n"
  },
  "steps": [
    {
      "id": "install",
      "command": "npm",
      "args": ["install", "@anthropic-ai/sdk@latest"],
      "timeoutMs": 120000,
      "expect": {
        "exitCode": 0
      }
    },
    {
      "id": "resolved-version",
      "command": "npm",
      "args": ["list", "@anthropic-ai/sdk", "--depth=0", "--json"],
      "timeoutMs": 30000,
      "expect": {
        "exitCode": 0
      }
    },
    {
      "id": "verify-client",
      "command": "node",
      "args": ["example.mjs"],
      "timeoutMs": 30000,
      "expect": {
        "exitCode": 0,
        "stdoutIncludes": ["anthropic-sdk-ready"]
      }
    }
  ]
}
