{
  "schemaVersion": 1,
  "name": "openai-python",
  "files": {
    "example.py": "from openai import OpenAI\n\nclient = OpenAI(api_key=\"docrun-local-test-key\")\nassert hasattr(client, \"responses\") or hasattr(client, \"chat\")\nprint(\"openai-python-ready\")\n"
  },
  "steps": [
    {
      "id": "install",
      "command": "pip",
      "args": ["install", "--no-input", "openai"],
      "timeoutMs": 240000,
      "expect": {
        "exitCode": 0
      }
    },
    {
      "id": "resolved-version",
      "command": "pip",
      "args": ["list", "--format=json"],
      "timeoutMs": 30000,
      "expect": {
        "exitCode": 0
      }
    },
    {
      "id": "verify-client",
      "command": "python",
      "args": ["example.py"],
      "timeoutMs": 30000,
      "expect": {
        "exitCode": 0,
        "stdoutIncludes": ["openai-python-ready"]
      }
    }
  ]
}
